{
  "name": "labview-clad-emulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Professional CLAD (Certified LabVIEW Associate Developer) practice assessment platform with document-backed explanations.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:index && tsc -b && vite build",
    "build:index": "node scripts/build-doc-index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
